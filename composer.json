{
    "name": "mrsuner/laravel-api-keys",
    "type": "library",
    "description": "Developer API key management (prefix-routed keys, rotation with overlap, per-key rate limits, async usage tracking) for Laravel. Works standalone and auto-wires into mrsuner/laravel-api-boilerplate.",
    "keywords": ["laravel", "api-keys", "authentication", "sanctum", "rate-limit", "boilerplate"],
    "license": "MIT",
    "homepage": "https://github.com/mrsuner/laravel-api-keys",
    "support": {
        "issues": "https://github.com/mrsuner/laravel-api-keys/issues",
        "source": "https://github.com/mrsuner/laravel-api-keys"
    },
    "authors": [
        {
            "name": "mrsuner"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.69|^13.30"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/sanctum": "^4.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8"
    },
    "suggest": {
        "laravel/sanctum": "Required so a resolved API key authenticates identically to a Sanctum token (auth:sanctum / ability:admin)."
    },
    "autoload": {
        "psr-4": {
            "Mrsuner\\ApiKeys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mrsuner\\ApiKeys\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/helpers.php"
        ]
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mrsuner\\ApiKeys\\ApiKeyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
